# Dezprox Frontend - Environment Variables

# The URL of the backend API (required for production builds).
# For local Vite dev you can omit this and use VITE_DEV_API_PROXY in vite.config instead.
# VITE_API_URL=http://localhost:4001

# When VITE_API_URL is unset, Vite proxies API traffic here (match Nest PORT in dezprox-backend/.env).
# `.env.development` sets a default; override here or in `.env.local` if your Nest uses another port (e.g. Docker publishes 4000).
VITE_DEV_API_PROXY=http://localhost:4001

# Sentry DSN for error tracking (Optional in development)
VITE_SENTRY_DSN=
