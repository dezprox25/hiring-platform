# --- APP ---
PORT=4000
NODE_ENV=staging
APP_URL=https://api-staging.dezprox.com
FRONTEND_URL=https://app-staging.dezprox.com

# --- DATABASE ---
DB_HOST=postgres-staging
DB_PORT=5432
DB_USER=postgres
DB_PASS=staging-password
DB_NAME=dezprox_staging
DB_SSL=true

# --- REDIS ---
REDIS_HOST=redis-staging
REDIS_PORT=6379
REDIS_PASSWORD=staging-redis-password
REDIS_DB=0

# --- JWT ---
JWT_SECRET=staging-secret-at-least-32-chars
JWT_REFRESH_SECRET=staging-refresh-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- AI (OPENAI) ---
OPENAI_API_KEY=sk-xxxx
AI_MODEL=gpt-4-turbo

# --- MAIL ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
MAIL_FROM="Dezprox Hiring Staging <noreply@dezprox.com>"

# --- OBSERVABILITY ---
SENTRY_DSN=https://xxx@sentry.io/xxx
