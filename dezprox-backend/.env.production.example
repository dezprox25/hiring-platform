# --- APP ---
PORT=4000
NODE_ENV=production
APP_URL=https://api.dezprox.com
FRONTEND_URL=https://app.dezprox.com

# --- DATABASE ---
# In production, use the service name if in Docker, or the cloud DB host
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASS=secure-password
DB_NAME=dezprox
DB_SSL=true

# --- REDIS ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secure-redis-password
REDIS_DB=0

# --- JWT ---
# Use 'openssl rand -base64 32' to generate secrets
JWT_SECRET=production-secret-at-least-32-chars
JWT_REFRESH_SECRET=production-refresh-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- AI (OPENAI) ---
OPENAI_API_KEY=sk-xxxx
AI_MODEL=gpt-4-turbo

# --- MAIL ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
MAIL_FROM="Dezprox Hiring <noreply@dezprox.com>"

# --- OBSERVABILITY ---
SENTRY_DSN=https://xxx@sentry.io/xxx
