# --- APP ---
PORT=4000
# Use development locally so an empty database auto-seeds demo staff (see UsersService).
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Optional: force demo user seed when users table is empty (also works in staging).
# Otherwise, auto-seed runs only when NODE_ENV is not production or staging.
SEED_DEV_LOGIN_USERS=false

# --- DATABASE ---
# Railway local dev: set DATABASE_PUBLIC_URL to the TCP proxy URL from the Postgres Connect tab.
# DATABASE_PUBLIC_URL=postgresql://postgres:PASSWORD@proxy-host.railway.app:PORT/railway
DATABASE_PUBLIC_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=dezprox
DB_SSL=false

# --- REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT ---
# Use 'openssl rand -base64 32' to generate secrets
JWT_SECRET=your-secret-key-at-least-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- AI (OPENAI) ---
OPENAI_API_KEY=sk-xxxx
AI_MODEL=gpt-4-turbo

# --- MAIL ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
MAIL_FROM="Dezprox Hiring <noreply@dezprox.com>"

# --- OBSERVABILITY ---
SENTRY_DSN=

# --- Local login ---
# Frontend must target this API (see project root .env): VITE_API_URL=http://localhost:4000
# After migrations, either set SEED_DEV_LOGIN_USERS=true once, or insert a user row manually.
